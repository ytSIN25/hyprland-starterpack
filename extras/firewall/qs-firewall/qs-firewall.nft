#!/usr/bin/nft -f
# Quickshell firewall: blocks connections nobody asked for.
# Lives in its own table, so Docker's and Tailscale's rules are left alone.
# On/off from the bar (systemctl start/stop qs-firewall).
# Source: ~/.config/quickshell/scripts/qs-firewall.nft, installed to /etc.
#
# Kernel log prefixes read by the bar (Services/FwActivity.qml, ScanWatch.qml):
#   qs-fw-in:   a new connection or ping from another machine got through
#   qs-fw-drop: a packet was blocked
#   qs-fw-stealth: FIN / NULL / Xmas probe (stealth port scan), always dropped
#   qs-fw-ping: every echo request (max 2/s per IP), so the bar can keep the
#               ping popup up for as long as the ping lasts
# Logging is limited per source IP (not for the whole PC), so a port scan
# logs enough of its ports for ScanWatch to see it and list them; a global
# cap on top keeps a flood from many addresses out of the journal.

add table inet qs_firewall
delete table inet qs_firewall

table inet qs_firewall {
    # Per-source log budgets (entries expire a minute after the last packet)
    set drop4 { type ipv4_addr; flags dynamic, timeout; timeout 1m; size 8192; }
    set drop6 { type ipv6_addr; flags dynamic, timeout; timeout 1m; size 8192; }
    set in4   { type ipv4_addr; flags dynamic, timeout; timeout 1m; size 8192; }
    set in6   { type ipv6_addr; flags dynamic, timeout; timeout 1m; size 8192; }
    set ping4 { type ipv4_addr; flags dynamic, timeout; timeout 1m; size 8192; }
    set ping6 { type ipv6_addr; flags dynamic, timeout; timeout 1m; size 8192; }

    # IPs blocked from the bar (scan alert → Block), via /usr/local/sbin/qs-fw-block.
    # Each entry has its own timeout; reloading the firewall empties them.
    set blocked4 { type ipv4_addr; flags timeout; }
    set blocked6 { type ipv6_addr; flags timeout; }

    chain input {
        type filter hook input priority filter; policy drop;

        # Blocked IPs first: not even replies to old connections get through
        ip saddr @blocked4 drop
        ip6 saddr @blocked6 drop

        # Stealth scans (nmap -sF / -sN / -sX): TCP with FIN and no ACK, or no
        # flags at all. Real traffic never looks like this, so log and drop.
        meta nfproto ipv4 tcp flags & (fin|syn|rst|psh|ack|urg) { 0x0, fin, fin|psh|urg } update @drop4 { ip saddr limit rate 20/second burst 150 packets } limit rate 400/second burst 1000 packets log prefix "qs-fw-stealth: " level info
        meta nfproto ipv6 tcp flags & (fin|syn|rst|psh|ack|urg) { 0x0, fin, fin|psh|urg } update @drop6 { ip6 saddr limit rate 20/second burst 150 packets } limit rate 400/second burst 1000 packets log prefix "qs-fw-stealth: " level info
        tcp flags & (fin|syn|rst|psh|ack|urg) { 0x0, fin, fin|psh|urg } drop

        # Every ping packet (not only the first), for the bar's live ping popup.
        # Only logs; whether it's let in is decided below as before.
        iif != "lo" icmp type echo-request update @ping4 { ip saddr limit rate 2/second burst 4 packets } log prefix "qs-fw-ping: " level info
        iif != "lo" icmpv6 type echo-request update @ping6 { ip6 saddr limit rate 2/second burst 4 packets } log prefix "qs-fw-ping: " level info

        ct state invalid drop
        ct state { established, related } accept comment "replies to things this PC started"
        iif "lo" accept

        # Background chatter, not someone connecting: allowed without logging
        icmpv6 type != echo-request accept comment "IPv6 needs ICMPv6 (neighbour discovery...)"
        icmp type != echo-request accept
        udp dport { 9993, 41641 } accept comment "ZeroTier / Tailscale direct links"
        udp sport 67 udp dport 68 accept comment "DHCP"
        udp sport 547 udp dport 546 accept comment "DHCPv6"
        udp dport 5353 accept comment "mDNS"

        jump allowed

        # Everything else is dropped; log it (rate-limited per source) so the bar can show it
        pkttype host meta nfproto ipv4 update @drop4 { ip saddr limit rate 20/second burst 150 packets } limit rate 400/second burst 1000 packets log prefix "qs-fw-drop: " level info
        pkttype host meta nfproto ipv6 update @drop6 { ip6 saddr limit rate 20/second burst 150 packets } limit rate 400/second burst 1000 packets log prefix "qs-fw-drop: " level info
    }

    # New connections that are let in; each one goes to the bar's activity list
    chain allowed {
        # Your own private networks are trusted (VNC from the MacBook comes over ZeroTier)
        iifname "zt*" goto log_accept
        iifname "tailscale0" goto log_accept

        meta l4proto { icmp, ipv6-icmp } goto log_accept comment "ping"
        tcp dport 22 goto log_accept comment "SSH (only answers when the bar toggle has sshd on)"
        tcp dport 24800 goto log_accept comment "Deskflow"
    }

    chain log_accept {
        meta nfproto ipv4 update @in4 { ip saddr limit rate 20/second burst 150 packets } limit rate 400/second burst 1000 packets log prefix "qs-fw-in: " level info
        meta nfproto ipv6 update @in6 { ip6 saddr limit rate 20/second burst 150 packets } limit rate 400/second burst 1000 packets log prefix "qs-fw-in: " level info
        accept
    }
}
