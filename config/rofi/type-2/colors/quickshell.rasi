/* rofi colors generated by Quickshell — follows the wallpaper theme */

* {
    background:       #0f1419E6;
    background-alt:   #1e252fCC;
    foreground:       #ebedf0;
    foreground-dim:   #b0b6bf;
    selected:         #86afea;
    on-selected:      #1a1a1a;
    selected-soft:    #86afea2E;
    border-col:       #86afea55;
    active:           #85c4d6;
    urgent:           #da6c91;
}
