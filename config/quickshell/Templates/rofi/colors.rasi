/* rofi colors generated by Quickshell — follows the wallpaper theme */

* {
    background:       {{background}}E6;
    background-alt:   {{surfaceContainerHigh}}CC;
    foreground:       {{onSurface}};
    foreground-dim:   {{onSurfaceVariant}};
    selected:         {{primary}};
    on-selected:      {{onPrimary}};
    selected-soft:    {{primary}}2E;
    border-col:       {{primary}}55;
    active:           {{tertiary}};
    urgent:           {{error}};
}
