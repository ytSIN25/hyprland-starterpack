import QtQuick
import QtQuick.Layouts
import Quickshell.Io
import Quickshell.Services.UPower
import qs.Components
import qs.Config
import qs.Services

// Detalle de batería: cabecera con estado + %, barra de progreso, info de
// tamaño/ciclos/tiempo restante (vía `upower -i`, ya que esas propiedades no
// están expuestas de forma fiable por el binding de UPower en QML), y el
// selector de perfil de energía reutilizado tal cual de PowerDetail.qml.
Popout {
    id: panel
    ns: "qs-battery"
    cardWidth: 380
    cardMinWidth: 320
    scrollable: false
    shown: Globals.batteryOpen

    onShownChanged: if (shown) fetchProc.running = true

    readonly property var dev: {
        const devices = UPower.devices ?? []
        for (let i = 0; i < devices.length; i++) {
            const d = devices[i]
            if (d && ((d.type === "Battery") || (d.isLaptopBattery ?? false)))
                return d
        }
        return UPower.displayDevice
    }
    readonly property int percent: Math.max(0, Math.min(100, Math.round((dev?.percentage ?? 0) * 100)))
    readonly property bool charging: (dev?.state ?? 0) === UPowerDeviceState.Charging
                                     || (dev?.state ?? 0) === UPowerDeviceState.PendingCharge
    readonly property bool fullyCharged: (dev?.state ?? 0) === UPowerDeviceState.FullyCharged
    readonly property string statusLabel:
        fullyCharged ? I18n.tr("FULLY CHARGED")
        : charging ? I18n.tr("CHARGING")
        : I18n.tr("DISCHARGING")

    // Datos que `upower -i` da y el binding QML no expone de forma fiable.
    property string sizeWh: "-"
    property string cycles: "-"
    property string timeToFull: "-"
    property string timeToEmpty: "-"

    Process {
        id: fetchProc
        command: ["sh", "-c", "upower -i $(upower -e | grep -i battery | head -n1) 2>/dev/null"]
        stdout: StdioCollector {
            onStreamFinished: {
                const lines = (this.text || "").split("\n")
                for (const raw of lines) {
                    const line = raw.trim()
                    if (line.indexOf("energy-full:") === 0)
                        panel.sizeWh = line.split(":")[1].trim().replace(" Wh", "Wh")
                    else if (line.indexOf("charge-cycles:") === 0)
                        panel.cycles = line.split(":")[1].trim()
                    else if (line.indexOf("time to full:") === 0)
                        panel.timeToFull = line.split(":").slice(1).join(":").trim()
                    else if (line.indexOf("time to empty:") === 0)
                        panel.timeToEmpty = line.split(":").slice(1).join(":").trim()
                }
            }
        }
    }

    Rectangle {
        Layout.fillWidth: true
        implicitHeight: body.implicitHeight + Theme.space16 * 2
        radius: Theme.barRadius
        color: Theme.withAlpha(Theme.surface, 0.62)
        border.width: Theme.hairline
        border.color: Theme.withAlpha(Theme.overlay, 0.34)

        ColumnLayout {
            id: body
            anchors.fill: parent
            anchors.margins: Theme.space14
            spacing: Theme.space10

            // Cabecera: icono + "Battery" + estado, % grande a la derecha.
            RowLayout {
                Layout.fillWidth: true
                spacing: Theme.space8

                // Icono dibujado (rectángulos), no depende de que la fuente
                // tenga el glifo — el mismo problema que ya tuvo el icono
                // del pill de la barra.
                Item {
                    implicitWidth: Theme.dp(24)
                    implicitHeight: Theme.dp(14)
                    Layout.alignment: Qt.AlignVCenter

                    Rectangle {
                        id: battBody
                        width: parent.width - Theme.dp(3)
                        height: parent.height
                        radius: Theme.dp(3)
                        color: "transparent"
                        border.width: Theme.dp(1.5)
                        border.color: Theme.fg
                    }
                    Rectangle {
                        anchors.left: battBody.right
                        anchors.verticalCenter: battBody.verticalCenter
                        width: Theme.dp(3)
                        height: Theme.dp(6)
                        radius: Theme.dp(1)
                        color: Theme.fg
                    }
                    Rectangle {
                        anchors.left: battBody.left
                        anchors.verticalCenter: battBody.verticalCenter
                        anchors.leftMargin: Theme.dp(2)
                        height: battBody.height - Theme.dp(4)
                        width: Math.max(Theme.dp(2), (battBody.width - Theme.dp(4)) * panel.percent / 100)
                        radius: Theme.dp(1)
                        color: panel.charging ? Theme.cyan : Theme.fg
                        Behavior on width { NumberAnimation { duration: Theme.animFast } }
                    }
                    // Rayo pequeño en la esquina si está cargando — decorativo,
                    // no crítico si el glifo no existe en la fuente.
                    Text {
                        visible: panel.charging
                        anchors.centerIn: parent
                        text: "\u26A1"
                        color: Theme.cyan
                        font.pixelSize: Theme.dp(11)
                        style: Text.Outline
                        styleColor: Theme.surface
                    }
                }

                ColumnLayout {
                    spacing: 0
                    Text {
                        text: I18n.tr("Battery")
                        color: Theme.fg
                        font.family: Theme.fontFamily
                        font.pixelSize: Theme.fontSize + 2
                        font.bold: true
                    }
                    Text {
                        text: panel.statusLabel
                        color: Theme.fgDim
                        font.family: Theme.fontFamily
                        font.pixelSize: Theme.fontSize - 4
                        font.bold: true
                    }
                }

                Item { Layout.fillWidth: true }

                Text {
                    text: panel.percent + "%"
                    color: Theme.fg
                    font.family: Theme.fontFamily
                    font.pixelSize: Theme.fontSize + 10
                    font.bold: true
                }
            }

            // Barra de progreso.
            Rectangle {
                Layout.fillWidth: true
                implicitHeight: Theme.dp(8)
                radius: height / 2
                color: Theme.withAlpha(Theme.overlay, 0.35)

                Rectangle {
                    height: parent.height
                    width: parent.width * panel.percent / 100
                    radius: height / 2
                    color: Theme.fg
                    Behavior on width { NumberAnimation { duration: Theme.animFast } }
                }
            }

            // Rejilla de info: tamaño/ciclos a la izquierda, tiempos a la derecha.
            GridLayout {
                Layout.fillWidth: true
                columns: 2
                columnSpacing: Theme.space16
                rowSpacing: Theme.space4

                InfoRow { label: I18n.tr("Battery size"); value: panel.sizeWh }
                InfoRow { label: I18n.tr("Time to full"); value: panel.charging ? panel.timeToFull : "-" }
                InfoRow { label: I18n.tr("Charge cycles"); value: panel.cycles }
                InfoRow { label: I18n.tr("Charging"); value: panel.charging ? I18n.tr("Yes") : "-" }
            }

            Rectangle {
                Layout.fillWidth: true
                implicitHeight: Theme.hairline
                color: Theme.withAlpha(Theme.overlay, 0.28)
            }

            Text {
                text: I18n.tr("POWER PROFILE")
                color: Theme.fgDim
                font.family: Theme.fontFamily
                font.pixelSize: Theme.fontSize - 4
                font.bold: true
            }

            // Mismas filas de perfil que PowerDetail.qml, reutilizadas tal cual.
            ColumnLayout {
                Layout.fillWidth: true
                spacing: Theme.space6
                Repeater {
                    model: Power.profiles
                    delegate: ProfileRow {
                        required property var modelData
                        info: modelData
                    }
                }
            }

            Rectangle {
                Layout.fillWidth: true
                implicitHeight: Theme.hairline
                color: Theme.withAlpha(Theme.overlay, 0.28)
            }

            // Fan control UI. The helper bridge intentionally fails closed
            // unless a compatible backend has been installed and configured.
            ColumnLayout {
                id: fanControl
                Layout.fillWidth: true
                spacing: Theme.space8

                property int fanLevel: 0
                property bool automaticMode: true
                property string fanStatus: "Backend not configured"
                property bool graphVisible: false
                property int selectedFan: 0
                property var curvePoints: [
                    {t: 42, a: 1400, b: 1400}, {t: 63, a: 3400, b: 3400},
                    {t: 72, a: 3700, b: 3700}, {t: 78, a: 4200, b: 4200},
                    {t: 85, a: 4200, b: 4200}, {t: 91, a: 4200, b: 4200},
                    {t: 95, a: 4200, b: 4200}, {t: 100, a: 5400, b: 5400}
                ]
                property int draggingNode: -1
                property bool applyingCurve: false
                function clamp(v, lo, hi) { return Math.max(lo, Math.min(hi, v)) }
                function graphX(temp) { return 34 + (temp / 110) * Math.max(1, curveCanvas.width - 48) }
                function graphY(rpm) { return curveCanvas.height - 26 - ((rpm - 1000) / 5000) * Math.max(1, curveCanvas.height - 44) }
                function updateGraph() { curveCanvas.requestPaint() }
                function applyGraphCurve() {
                    curveApplyProc.command = ["sudo", "-n", "/usr/local/sbin/quickshell-fan-curve", JSON.stringify(curvePoints)]
                    curveApplyProc.running = true
                    applyingCurve = true
                    automaticMode = false
                }

                Process {
                    id: curveApplyProc
                    command: ["true"]
                    stdout: StdioCollector { onStreamFinished: { fanControl.applyingCurve = false; fanStatusProc.running = true } }
                    stderr: StdioCollector { onStreamFinished: { fanControl.applyingCurve = false; fanStatusProc.running = true } }
                }

                Process {
                    id: fanStatusProc
                    command: ["sh", "-lc", "command -v quickshell-fan-control >/dev/null 2>&1 && quickshell-fan-control status || echo 'Backend not configured'"]
                    stdout: StdioCollector {
                        onStreamFinished: fanControl.fanStatus = (this.text || "").trim()
                    }
                }

                Process {
                    id: fanApplyProc
                    command: ["sh", "-lc", "quickshell-fan-control set " + fanControl.fanLevel]
                    stdout: StdioCollector {
                        onStreamFinished: fanStatusProc.running = true
                    }
                    stderr: StdioCollector {
                        onStreamFinished: fanStatusProc.running = true
                    }
                }

                // Automatic mode restores the saved hardware fan curve,
                // which adjusts fan speed according to temperature.
                // Manual slider changes are applied after a short debounce.
                Timer {
                    id: fanApplyDebounce
                    interval: 500
                    repeat: false
                    onTriggered: {
                        if (fanControl.fanStatus !== "Backend not configured")
                            fanApplyProc.running = true
                    }
                }

                Component.onCompleted: fanStatusProc.running = true

                RowLayout {
                    Layout.fillWidth: true
                    Text {
                        text: "FAN CURVE"
                        color: Theme.fgDim
                        font.family: Theme.fontFamily
                        font.pixelSize: Theme.fontSize - 4
                        font.bold: true
                    }
                    Item { Layout.fillWidth: true }
                    Text {
                        text: fanControl.automaticMode ? "AUTO" : fanControl.fanLevel + "%"
                        color: Theme.accent
                        font.family: Theme.fontFamily
                        font.pixelSize: Theme.fontSize
                        font.bold: true
                    }
                }

                RowLayout {
                    Layout.fillWidth: true
                    Text { text: "Editable temperature curve"; color: Theme.fgDim; font.family: Theme.fontFamily; font.pixelSize: Theme.fontSize - 2 }
                    Item { Layout.fillWidth: true }
                    Rectangle {
                        radius: Theme.pillRadius; color: fanControl.graphVisible ? Theme.withAlpha(Theme.accent, 0.24) : Theme.withAlpha(Theme.surface, 0.5)
                        border.width: Theme.hairline; border.color: Theme.withAlpha(Theme.overlay, 0.4)
                        implicitWidth: graphToggleText.implicitWidth + Theme.space16; implicitHeight: Theme.rowM
                        Text { id: graphToggleText; anchors.centerIn: parent; text: fanControl.graphVisible ? "Hide graph" : "Show graph"; color: Theme.fg; font.family: Theme.fontFamily; font.pixelSize: Theme.fontSize - 1 }
                        MouseArea { anchors.fill: parent; cursorShape: Qt.PointingHandCursor; onClicked: { fanControl.graphVisible = !fanControl.graphVisible; fanControl.updateGraph() } }
                    }
                }
                ColumnLayout {
                    visible: fanControl.graphVisible
                    Layout.fillWidth: true
                    spacing: Theme.space6
                    RowLayout {
                        Layout.fillWidth: true
                        Text { text: "Editing"; color: Theme.fgDim; font.family: Theme.fontFamily; font.pixelSize: Theme.fontSize - 2 }
                        Rectangle {
                            radius: Theme.pillRadius
                            color: fanControl.selectedFan === 0 ? Theme.withAlpha(Theme.accent, 0.3) : "transparent"
                            implicitHeight: Theme.rowM
                            implicitWidth: f1Text.implicitWidth + Theme.space12
                            Text {
                                id: f1Text
                                anchors.centerIn: parent
                                text: "Fan 1"
                                color: Theme.fg
                                font.pixelSize: Theme.fontSize - 1
                            }
                            MouseArea {
                                anchors.fill: parent
                                onClicked: { fanControl.selectedFan = 0; fanControl.updateGraph() }
                            }
                        }
                        Rectangle {
                            radius: Theme.pillRadius
                            color: fanControl.selectedFan === 1 ? Theme.withAlpha(Theme.accent, 0.3) : "transparent"
                            implicitHeight: Theme.rowM
                            implicitWidth: f2Text.implicitWidth + Theme.space12
                            Text {
                                id: f2Text
                                anchors.centerIn: parent
                                text: "Fan 2"
                                color: Theme.fg
                                font.pixelSize: Theme.fontSize - 1
                            }
                            MouseArea {
                                anchors.fill: parent
                                onClicked: { fanControl.selectedFan = 1; fanControl.updateGraph() }
                            }
                        }
                        Item { Layout.fillWidth: true }
                        Text { text: "Drag nodes · °C / RPM"; color: Theme.fgDim; font.pixelSize: Theme.fontSize-4 }
                    }
                    Canvas {
                        id: curveCanvas
                        Layout.fillWidth: true
                        implicitHeight: 190
                        onPaint: {
                            var c=getContext("2d"); c.reset(); c.clearRect(0,0,width,height)
                            var left=34, right=width-14, top=12, bottom=height-26
                            c.font="10px sans-serif"; c.lineWidth=1; c.strokeStyle=Theme.overlay; c.fillStyle=Theme.fgDim
                            for(var t=0;t<=100;t+=20){var x=left+(t/110)*(right-left);c.beginPath();c.moveTo(x,top);c.lineTo(x,bottom);c.stroke();c.fillText(t+"°",x-7,height-8)}
                            for(var r=1000;r<=6000;r+=1000){var y=bottom-((r-1000)/5000)*(bottom-top);c.beginPath();c.moveTo(left,y);c.lineTo(right,y);c.stroke();c.fillText(r/1000+"k",2,y+3)}
                            c.strokeStyle=fanControl.selectedFan===0?Theme.accent:Theme.cyan; c.lineWidth=2;c.beginPath()
                            for(var i=0;i<fanControl.curvePoints.length;i++){var p=fanControl.curvePoints[i],xx=fanControl.graphX(p.t),yy=fanControl.graphY(fanControl.selectedFan===0?p.a:p.b);if(i===0)c.moveTo(xx,yy);else c.lineTo(xx,yy)}c.stroke()
                            for(var j=0;j<fanControl.curvePoints.length;j++){var q=fanControl.curvePoints[j],nx=fanControl.graphX(q.t),ny=fanControl.graphY(fanControl.selectedFan===0?q.a:q.b);c.beginPath();c.arc(nx,ny,5,0,Math.PI*2);c.fillStyle=Theme.accent;c.fill();c.strokeStyle=Theme.surface;c.lineWidth=1.5;c.stroke()}
                        }
                        MouseArea {
                            anchors.fill: parent
                            onPressed: (mouse) => {
                                var best=-1, dist=18
                                for(var i=0;i<fanControl.curvePoints.length;i++){var p=fanControl.curvePoints[i];var dx=fanControl.graphX(p.t)-mouse.x;var yy=fanControl.graphY(fanControl.selectedFan===0?p.a:p.b);var d=Math.sqrt(dx*dx+(yy-mouse.y)*(yy-mouse.y));if(d<dist){dist=d;best=i}}
                                fanControl.draggingNode=best
                            }
                            onPositionChanged: (mouse) => {
                                var i=fanControl.draggingNode;if(i<0)return
                                var pts=fanControl.curvePoints.slice(0);var p=Object.assign({},pts[i]);
                                p.t=Math.round(fanControl.clamp((mouse.x-34)/Math.max(1,curveCanvas.width-48)*110,0,110));
                                var rpm=Math.round(fanControl.clamp(1000+(curveCanvas.height-26-mouse.y)/Math.max(1,curveCanvas.height-44)*5000,1000,6000)/100)*100;
                                if(fanControl.selectedFan===0)p.a=rpm;else p.b=rpm;
                                pts[i]=p;fanControl.curvePoints=pts;fanControl.updateGraph()
                            }
                            onReleased: fanControl.draggingNode=-1
                            onCanceled: fanControl.draggingNode=-1
                        }
                    }
                    RowLayout {
                        Layout.fillWidth: true
                        Text { text: fanControl.curvePoints.length + " points"; color: Theme.fgDim; font.pixelSize: Theme.fontSize-2 }
                        Item { Layout.fillWidth: true }
                        Rectangle {
                            radius: Theme.pillRadius
                            color: Theme.withAlpha(Theme.surface, 0.6)
                            implicitHeight: Theme.rowM
                            implicitWidth: removeNodeText.implicitWidth + Theme.space12
                            Text {
                                id: removeNodeText
                                anchors.centerIn: parent
                                text: "Remove last node"
                                color: Theme.fg
                                font.pixelSize: Theme.fontSize - 2
                            }
                            MouseArea {
                                anchors.fill: parent
                                enabled: fanControl.curvePoints.length > 2
                                onClicked: {
                                    var pts = fanControl.curvePoints.slice(0)
                                    pts.pop()
                                    fanControl.curvePoints = pts
                                    fanControl.updateGraph()
                                }
                            }
                        }
                        Rectangle {
                            radius: Theme.pillRadius
                            color: Theme.withAlpha(Theme.surface, 0.6)
                            implicitHeight: Theme.rowM
                            implicitWidth: addNodeText.implicitWidth + Theme.space12
                            Text {
                                id: addNodeText
                                anchors.centerIn: parent
                                text: "Add node"
                                color: Theme.fg
                                font.pixelSize: Theme.fontSize - 2
                            }
                            MouseArea {
                                anchors.fill: parent
                                enabled: fanControl.curvePoints.length < 10
                                onClicked: {
                                    var pts = fanControl.curvePoints.slice(0)
                                    var last = pts[pts.length - 1]
                                    pts.push({t: Math.min(110, last.t + 5), a: last.a, b: last.b})
                                    fanControl.curvePoints = pts
                                    fanControl.updateGraph()
                                }
                            }
                        }
                        Rectangle {
                            radius: Theme.pillRadius
                            color: Theme.withAlpha(Theme.accent, 0.28)
                            implicitHeight: Theme.rowM
                            implicitWidth: applyCurveText.implicitWidth + Theme.space12
                            Text {
                                id: applyCurveText
                                anchors.centerIn: parent
                                text: fanControl.applyingCurve ? "Applying…" : "Apply curve"
                                color: Theme.fg
                                font.pixelSize: Theme.fontSize - 2
                                font.bold: true
                            }
                            MouseArea {
                                anchors.fill: parent
                                enabled: !fanControl.applyingCurve
                                onClicked: fanControl.applyGraphCurve()
                            }
                        }
                    }
                    Text { text: "Curve apply requires the companion installer from the ZIP. Automatic restores your baseline curve."; color: Theme.fgDim; wrapMode: Text.Wrap; Layout.fillWidth:true; font.pixelSize:Theme.fontSize-3 }
                }

                SliderRow {
                    Layout.fillWidth: true
                    label: "Cooling intensity"
                    glyph: "󰈐"
                    from: 0
                    to: 100
                    value: fanControl.fanLevel
                    valueText: fanControl.fanLevel + "%"
                    onMoved: (v) => {
                        fanControl.automaticMode = false
                        fanControl.fanLevel = Math.round(v / 5) * 5
                        fanApplyDebounce.restart()
                    }
                }

                RowLayout {
                    Layout.fillWidth: true
                    Item { Layout.fillWidth: true }
                    Rectangle {
                        radius: Theme.pillRadius
                        color: fanControl.automaticMode
                               ? Theme.withAlpha(Theme.accent, 0.28)
                               : Theme.withAlpha(Theme.accent, 0.12)
                        border.width: Theme.hairline
                        border.color: Theme.withAlpha(Theme.accent, 0.65)
                        implicitWidth: autoLabel.implicitWidth + Theme.space16
                        implicitHeight: Theme.rowM
                        Text {
                            id: autoLabel
                            anchors.centerIn: parent
                            text: "Automatic"
                            color: Theme.fg
                            font.family: Theme.fontFamily
                            font.pixelSize: Theme.fontSize - 1
                            font.bold: true
                        }
                        MouseArea {
                            anchors.fill: parent
                            cursorShape: Qt.PointingHandCursor
                            enabled: fanControl.fanStatus !== "Backend not configured"
                            onClicked: {
                                fanApplyDebounce.stop()
                                fanControl.automaticMode = true
                                fanControl.fanLevel = 0
                                fanApplyProc.running = true
                            }
                        }
                    }
                }
            }
        }
    }

    component InfoRow: RowLayout {
        property string label: ""
        property string value: ""
        Layout.fillWidth: true
        spacing: Theme.space6

        Text {
            text: label
            color: Theme.fgDim
            font.family: Theme.fontFamily
            font.pixelSize: Theme.fontSize - 2
        }
        Item { Layout.fillWidth: true }
        Text {
            text: value
            color: Theme.fg
            font.family: Theme.fontFamily
            font.pixelSize: Theme.fontSize - 2
            font.bold: true
        }
    }

    component ProfileRow: Rectangle {
        id: pr
        property var info
        readonly property bool active: Power.matches(info?.value ?? -1)

        Layout.fillWidth: true
        implicitHeight: Theme.rowL
        radius: Theme.pillRadius
        color: active ? Qt.rgba(info.color.r, info.color.g, info.color.b, 0.16)
                      : prMa.containsMouse ? Theme.surfaceHi : Theme.withAlpha(Theme.surface, 0.36)
        border.width: active ? Math.max(1, Theme.dp(2)) : Theme.hairline
        border.color: active ? info.color : Theme.withAlpha(Theme.overlay, 0.28)
        Behavior on color { ColorAnimation { duration: Theme.animFast } }

        RowLayout {
            anchors.fill: parent
            anchors.leftMargin: Theme.space10
            anchors.rightMargin: Theme.space10
            spacing: Theme.space8

            Text {
                text: pr.info?.icon ?? ""
                color: pr.active ? pr.info.color : Theme.fgDim
                font.family: Theme.fontFamily
                font.pixelSize: Theme.iconSize
            }
            Text {
                Layout.fillWidth: true
                text: pr.info?.label ?? ""
                color: pr.active ? Theme.fg : Theme.fgDim
                font.family: Theme.fontFamily
                font.pixelSize: Theme.fontSize - 1
                font.bold: pr.active
                elide: Text.ElideRight
            }
            Text {
                visible: pr.active
                text: I18n.tr("Active")
                color: pr.info.color
                font.family: Theme.fontFamily
                font.pixelSize: Theme.fontSize - 4
                font.bold: true
            }
            Text {
                visible: pr.active
                text: "󰓏"
                color: pr.info.color
                font.family: Theme.fontFamily
                font.pixelSize: Theme.iconSize
            }
        }

        MouseArea {
            id: prMa
            anchors.fill: parent
            hoverEnabled: true
            cursorShape: Qt.PointingHandCursor
            onClicked: Power.set(pr.info.value)
        }
    }
}
